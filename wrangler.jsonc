{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "playlist",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "RoomHub" }]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RoomDO"] },
    { "tag": "v2", "renamed_classes": [{ "from": "RoomDO", "to": "RoomHub" }] }
  ],
  "assets": {
    "directory": "./client/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/socket.io/*", "/api/*"]
  },
  "observability": { "enabled": true },
  "workers_dev": true,
  "routes": [{ "pattern": "playlist.fiinnyy.my.id/*", "zone_name": "fiinnyy.my.id" }]
}
