[Unit]
Description=Redis for playList (live queue + admin sessions)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/podman run --rm --name playmusic_redis -p 6104:6379 -v playmusic_redis_data:/data docker.io/library/redis:7-alpine redis-server --appendonly yes --requirepass REDIS
Restart=always
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=default.target
