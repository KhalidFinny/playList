{
  "name": "play-music",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "packageManager": "bun@1.3.14",
  "scripts": {
    "infra": "podman start playmusic_redis || docker start playmusic_redis",
    "dev": "vp run infra && vp run --filter client --filter server --parallel dev",
    "dev:client": "vp run --filter client dev",
    "dev:server": "vp run --filter server dev",
    "dev:legacy": "bun dev.ts",
    "check": "vp run -r check",
    "build": "vp run --filter client build",
    "start": "cd server && bun --env-file=../.env index.ts",
    "test": "docker compose up -d redis && bun --env-file=.env vitest run tests",
    "verify:specs": "bash specs/run.sh"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261009.1",
    "@effect/vitest": "^4.0.0-beta.79",
    "@types/bun": "^1.3.12",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "vite-plus": "latest",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "@xstate/react": "^6.1.0",
    "effect": "4.0.0-beta.79",
    "xstate": "^5.32.0",
    "zustand": "^5.0.14"
  }
}
